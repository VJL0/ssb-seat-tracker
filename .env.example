# Local CLI notification delivery
NTFY_TOPIC=replace-with-your-private-topic

# AWS production deployment / GitHub production environment variables
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-github-deploy-role
AWS_CFN_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-cloudformation-role
AWS_ARTIFACT_BUCKET=replace-with-bootstrap-artifact-bucket
NTFY_TOPIC_PARAMETER_NAME=/ssb-seat-tracker/ntfy-topic
ALERT_EMAIL=you@example.com
